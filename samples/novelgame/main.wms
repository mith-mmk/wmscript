export let title = "灯台図書館の夜";
export let description = "選択肢によってエンディングが変わる日本語ノベルゲームサンプル";
export let background_resource = 100;

export func main() {
    ext.scene.reset();
    ext.scene.layout(270, 92, 740, 230, 28, 384, 1224, 158);
    ext.image.draw_ext(ext.image.load(100), 0, 0, 1536, 1024, 0, 0, 1280, 720, 0, 1);

    ext.message.clear();
    ext.message.log_clear();
    ext.message.reset_style();
    ext.message.locale("ja");
    ext.message.box_style(8, 12, 22, 230, 40, 82, 108, 238);
    ext.message.text_color(238, 244, 250, 255);
    ext.message.speaker_color(255, 238, 190, 255);
    ext.message.accent_color(132, 220, 216, 255);
    ext.message.choice_box_style(10, 16, 28, 230, 54, 108, 126, 236);
    ext.message.choice_text_color(244, 248, 255, 255);
    ext.message.choice_accent_color(156, 228, 220, 255);
    ext.message.choice_selected_style(30, 86, 98, 218, 178, 238, 226, 240);
    ext.message.font_size(22, 24);
    ext.message.speed(24);
    ext.message.auto(false);

    ext.scene.opening("灯台図書館の夜");
    recv();

    ext.message.show(
        "語り",
        "岬の先に建つ灯台図書館は、夜だけ扉を開ける。\n司書のミオは、消えかけた灯火の下で一冊の航海日誌を見つけた。"
    );
    recv();

    ext.message.show(
        "ミオ",
        "この日誌、最後のページだけがまだ濡れている。\n今夜の霧は、ただの霧じゃない。"
    );
    recv();

    ext.message.show(
        "語り",
        "窓の外で鐘が鳴る。海から小舟の灯りがひとつ近づき、書架の奥では封印棚が軋んだ。\nミオはどこへ向かうべきだろうか。"
    );
    ext.message.choices_named(
        "sea", "小舟の灯りを追う",
        "shelf", "封印棚を開ける",
        "lamp", "灯台の火を守る"
    );
    recv();
    let route = state.get("ui.last_choice");
    ext.message.choices_named();

    if route != nil {
        state.set("save.novelgame.last_route", route);
        state.save(1);
        ext.vm.save(1);
    }

    if route == "sea" {
        ext.message.show(
            "語り",
            "ミオは外套を羽織り、霧に沈む石段を駆け下りた。\n小舟には誰も乗っていない。ただ、日誌と同じ筆跡で「帰り道を照らして」と書かれている。"
        );
        recv();
        ext.message.show(
            "ミオ",
            "迷っているのは船じゃない。帰れなくなった記憶なんだ。"
        );
        recv();
        ext.message.show(
            "語り",
            "ミオが日誌を小舟へ返すと、霧の中から古い船員たちの歌がほどけていく。\n夜明け、図書館の蔵書目録には「失われた航路」の一行が戻っていた。"
        );
        recv();
        ext.scene.ending("Ending A: 霧の帰港");
        recv();
        state.set("save.novelgame.ending", "fog-harbor");
        state.save(1);
        return "ending-fog-harbor";
    } else if route == "shelf" {
        ext.message.show(
            "語り",
            "封印棚の錠前は、ミオの手が触れる前にひらいた。\n中にあったのは白紙の本。表紙には、まだ生まれていない誰かの名前が浮かんでいる。"
        );
        recv();
        ext.message.show(
            "ミオ",
            "未来の本まで閉じ込めていたら、この図書館はただの倉庫になってしまう。"
        );
        recv();
        ext.message.show(
            "語り",
            "ミオは白紙の一ページ目に、今夜の出来事を書き込んだ。\nすると棚の本たちが小さく息を吹き返し、読まれる日を待つ声で満ちていった。"
        );
        recv();
        ext.scene.ending("Ending B: 白紙の目録");
        recv();
        state.set("save.novelgame.ending", "blank-catalog");
        state.save(1);
        return "ending-blank-catalog";
    } else if route == "lamp" {
        ext.message.show(
            "語り",
            "ミオは螺旋階段を上り、風に震える灯火へ両手をかざした。\n炎の芯には、灯台を建てた初代司書の小さな声が残っている。"
        );
        recv();
        ext.message.show(
            "初代司書",
            "本は道しるべだ。けれど、読む人が戻れる場所も必要だ。"
        );
        recv();
        ext.message.show(
            "語り",
            "ミオが火を守り抜くと、海も書架も同じ金色に染まった。\n迷った船も、閉じた本も、まずはこの明かりを目指して戻ってくる。"
        );
        recv();
        ext.scene.ending("Ending C: 灯を継ぐ司書");
        recv();
        state.set("save.novelgame.ending", "keeper-light");
        state.save(1);
        return "ending-keeper-light";
    }

    ext.message.show(
        "語り",
        "ミオは決められないまま、夜明けの鐘を聞いた。\n物語はまだ、次の選択を待っている。"
    );
    recv();
    return "ending-undecided";
}
