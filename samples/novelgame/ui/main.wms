export func main() {
    ui.reset();
    ui.layout(270, 92, 740, 230, 20, 502, 1240, 184);
    ui.background(100);

    text.reset_style();
    text.locale("ja");
    text.box_style(8, 12, 22, 230, 40, 82, 108, 238);
    text.text_color(238, 244, 250, 255);
    text.speaker_color(255, 238, 190, 255);
    text.accent_color(132, 220, 216, 255);
    text.choice_box_style(10, 16, 28, 230, 54, 108, 126, 236);
    text.choice_text_color(244, 248, 255, 255);
    text.choice_accent_color(156, 228, 220, 255);
    text.choice_selected_style(30, 86, 98, 218, 178, 238, 226, 240);
    text.font_size(22, 24);
    text.speed(24);
    text.auto(false);
    ui.context_menu(true);
    ui.shift_fast(true);

    return "ui-ready";
}
