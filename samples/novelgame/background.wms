export let background_resource = 100;

export func main() {
    ext.scene.reset();
    ext.scene.layout(270, 92, 740, 230, 20, 502, 1240, 184);
    ext.image.draw_ext(ext.image.load(100), 0, 0, 1536, 1024, 0, 0, 1280, 720, 0, 1);

    ext.message.reset_style();
    ext.message.locale("ja");
    ext.message.box_style(8, 12, 22, 230, 40, 82, 108, 238);
    ext.message.text_color(238, 244, 250, 255);
    ext.message.speaker_color(255, 238, 190, 255);
    ext.message.accent_color(132, 220, 216, 255);
    ext.message.choice_box_style(10, 16, 28, 230, 54, 108, 126, 236);
    ext.message.choice_text_color(244, 248, 255, 255);
    ext.message.choice_accent_color(156, 228, 220, 255);
    ext.message.choice_selected_style(30, 86, 98, 218, 178, 238, 226, 240);
    ext.message.font_size(22, 24);
    ext.message.speed(24);
    ext.message.auto(false);
    ext.ui.context_menu(true);
    ext.ui.shift_fast(true);

    return "background-ready";
}
