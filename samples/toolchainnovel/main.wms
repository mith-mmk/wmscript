export let title = "三番線の信号";
export let asset_note = "同梱ガイドデータを resource 100、背景画像を resource 101 として読み込みます。";

export func main() {
    state.set("debug.toolchain_asset_expected", true);

    ext.scene.reset();
    ext.scene.layout(260, 104, 760, 190, 20, 390, 1240, 132);
    ext.image.draw_ext(ext.image.load(101), 0, 0, 784, 565, 0, 0, 1280, 720, 0, 1);

    ext.message.clear();
    ext.message.log_clear();
    ext.message.reset_style();
    ext.message.box_style(8, 14, 24, 226, 32, 44, 58, 232);
    ext.message.text_color(238, 246, 255, 255);
    ext.message.speaker_color(255, 232, 188, 255);
    ext.message.accent_color(126, 214, 206, 255);
    ext.message.choice_box_style(12, 18, 30, 220, 72, 96, 120, 228);
    ext.message.choice_text_color(244, 248, 255, 255);
    ext.message.choice_accent_color(150, 224, 214, 255);
    ext.message.choice_selected_style(26, 82, 96, 210, 170, 236, 220, 235);
    ext.message.input_box_style(10, 16, 28, 232, 54, 72, 92, 226);
    ext.message.input_text_color(246, 250, 255, 255);
    ext.message.input_hint_color(170, 188, 204, 228);
    ext.message.input_prompt_color(166, 228, 218, 255);
    ext.message.font_size(22, 24);
    ext.message.speed(24);
    ext.message.auto(false);

    ext.message.show(
        "語り",
        "終電後の三番線に、まだ信号だけが灯っている。\n継電器の横で、保守パネルが短く点滅した。"
    );
    recv();

    ext.message.show(
        "管制",
        "次の行動を選んでください。\nこの実行では、梱包済みのガイド資料と背景画像も読み込まれています。"
    );
    ext.message.choices_named(
        "repair", "継電器を直す",
        "observe", "ホームを調べる"
    );
    recv();
    let action = state.get("ui.last_choice");

    ext.message.choices_named();

    if action != nil {
        state.set("save.toolchainnovel.last_action", action);
        state.save(1);
        ext.vm.save(1);
    }

    if action == "repair" {
        ext.message.show("管制", "保守カードに書かれた合言葉を入力してください。");
        ext.message.prompt("合言葉");
        recv();
        let word = state.get("ui.last_input");
        ext.message.prompt();

        if word == "lumen" {
            state.set("save.toolchainnovel.signal", "restored");
            state.save(1);
            ext.message.show("語り", "継電器が二度鳴り、ホームの灯りがゆっくり戻っていく。");
            recv();
            return "signal-restored";
        }

        state.set("save.toolchainnovel.signal", "manual-route");
        ext.message.show("語り", "合言葉は通らなかった。経路は手動復旧待ちとして記録される。");
        recv();
        return "manual-route";
    } else if action == "observe" {
        state.set("save.toolchainnovel.signal", "observed");
        state.save(1);
        ext.message.show("語り", "パネルから細い青い線が伸び、暗いトンネルの奥へ消えている。");
        recv();
        return "observation-log";
    }

    ext.message.show("語り", "行動は選ばれなかった。");
    recv();
    return "no-action";
}
