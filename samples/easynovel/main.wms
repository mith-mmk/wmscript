export let protagonist = "Aki";
export let setting = "last train platform";

export func main() {
    ext.message.clear();
    ext.message.log_clear();
    ext.message.reset_style();
    ext.message.frame(100);
    ext.message.content_inset(58, 34, 58, 26);
    ext.message.box_style(7, 12, 22, 214, 108, 198, 216, 255);
    ext.message.text_color(236, 244, 250, 255);
    ext.message.speaker_color(240, 250, 255, 255);
    ext.message.accent_color(140, 214, 234, 255);
    ext.message.input_box_style(12, 20, 34, 236, 124, 198, 228, 210);
    ext.message.input_text_color(244, 250, 255, 255);
    ext.message.input_hint_color(150, 182, 204, 228);
    ext.message.input_prompt_color(164, 226, 244, 255);
    ext.message.choice_box_style(8, 14, 26, 226, 92, 180, 214, 224);
    ext.message.choice_text_color(238, 246, 255, 255);
    ext.message.choice_accent_color(138, 220, 246, 255);
    ext.message.choice_selected_style(24, 64, 92, 196, 150, 230, 255, 228);
    ext.message.font_size(22, 24);
    ext.message.speed(26);
    ext.message.auto(false);
    ext.message.choices_named(
        "prologue", "Prologue",
        "chapter_1", "Chapter 1",
        "chapter_2", "Chapter 2"
    );
    ext.message.prompt("Select a chapter");
    ext.message.show(
        "Narrator",
        "The station is quiet tonight.\nChoose a chapter to open the next page."
    );
    recv();
    let chapter = state.get("ui.last_choice");

    if chapter != nil {
        state.set("save.last_chapter", chapter);
        state.save(1);
        ext.vm.save(1);
    }

    ext.message.choices_named();
    ext.message.prompt();

    if chapter == "prologue" {
        if state.has("read:easynovel:prologue") {
            ext.message.skip(true);
        } else {
            ext.message.skip(false);
        }
        state.set("read:easynovel:prologue", true);
        ext.message.show(
            "Narrator",
            "The last train platform is almost empty.\nAki stops under the lantern light and listens to the rails."
        );
        recv();
        ext.message.show(
            "Aki",
            "The city feels farther away than usual."
        );
        recv();
        ext.message.skip(false);
        return;
    } else if chapter == "chapter_1" {
        if state.has("read:easynovel:chapter_1") {
            ext.message.skip(true);
        } else {
            ext.message.skip(false);
        }
        state.set("read:easynovel:chapter_1", true);
        ext.message.show(
            "Narrator",
            "A lantern lights the stairs down to the station.\nThe ticket gate hums in the background."
        );
        recv();
        ext.message.show(
            "Aki",
            "The next train is still ten minutes away."
        );
        recv();
        ext.message.show(
            "Narrator",
            "A quiet voice answers from the gate, and the chapter opens."
        );
        recv();
        ext.message.skip(false);
        return;
    } else if chapter == "chapter_2" {
        if state.has("read:easynovel:chapter_2") {
            ext.message.skip(true);
        } else {
            ext.message.skip(false);
        }
        state.set("read:easynovel:chapter_2", true);
        ext.message.show(
            "Narrator",
            "Aki chooses the quiet route home.\nThe station lights fade behind the empty road."
        );
        recv();
        ext.message.show(
            "Aki",
            "I'll take the river path tonight."
        );
        recv();
        ext.message.show(
            "Narrator",
            "The wind carries water across the railing and the chapter moves on."
        );
        recv();
        ext.message.skip(false);
        return;
    }

    ext.message.show("Narrator", "No chapter was selected.");
    recv();
    return;
}

