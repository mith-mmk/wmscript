export let title = "RPG Map Demo";
export let description = "64x64 scrolling 2D maps / pseudo-3D dungeon / event / battle sample";

export func main() {
    state.set("game.mode", "map");
    state.set("game.location", "town");
    state.set("game.last_action", "start");
    state.set("actor.hero.hp", 30);
    state.set("actor.hero.max_hp", 30);
    state.set("actor.hero.atk", 7);
    state.set("actor.hero.def", 2);
    state.set("actor.slime.hp", 18);
    state.set("inventory.potion", 1);
    state.set("resource.gold", 12);
    state.set("job.herb_garden.enabled", false);
    state.set("job.herb_garden.rate", 1);
    state.set("job.herb_garden.progress", 0);
    state.set("job.herb_garden.output", "inventory.potion");
    state.set("map.current", "town");
    state.set("map.projection", "tile2d");
    state.set("map.width", 64);
    state.set("map.height", 64);
    state.set("map.depth", 1);
    state.set("map.x", 30);
    state.set("map.y", 32);
    state.set("map.z", 0);
    state.set("map.facing", "north");
    state.set("map.last_blocked", false);
    state.set("map.transition", "none");
    state.set("dungeon.level", 0);
    state.set("flag.map_switched", false);
    state.set("flag.stone_read", false);
    state.set("flag.slime_defeated", false);
    state.set("flag.dungeon_descended", false);

    let town_map = ext.image.load(100);
    let forest_map = ext.image.load(101);
    let dungeon_map = ext.image.load(102);
    let battle_bg = ext.image.load(103);
    let actor_icons = ext.image.load(104);
    let landmark_icons = ext.image.load(105);
    let dungeon_view = ext.image.load(106);
    let stone_chime = ext.audio.load(203);
    let battle_hit = ext.audio.load(204);
    ext.image.set_icon_sheet(actor_icons, 64, 64);
    ext.image.set_icon_sheet(landmark_icons, 64, 64);

    ext.scene.reset();
    ui.layout(276, 80, 728, 244, 20, 500, 1240, 188);
    ui.background(100);
    text.reset_style();
    text.locale("ja");
    text.box_style(10, 14, 24, 232, 72, 112, 96, 238);
    text.text_color(240, 248, 246, 255);
    text.speaker_color(255, 226, 156, 255);
    text.accent_color(168, 230, 176, 255);
    text.choice_box_style(12, 20, 28, 232, 96, 148, 118, 238);
    text.choice_text_color(246, 252, 248, 255);
    text.choice_accent_color(180, 236, 188, 255);
    text.choice_selected_style(46, 104, 70, 218, 198, 242, 188, 242);
    text.font_size(22, 24);
    text.speed(26);
    text.auto(false);
    ui.context_menu(true);
    ui.shift_fast(true);
    ext.rpg.clear();
    text.clear();
    text.log_clear();
    text.show(
        "ギルド受付",
        "東門の先に森があります。森には古い石碑、跳ねるスライム、地下遺跡への階段があるそうです。"
    );
    recv();

    loop {
        state.set("game.mode", "map");
        let map = state.get("map.current");
        let x = state.get("map.x");
        let y = state.get("map.y");
        let z = state.get("map.z");
        let facing = state.get("map.facing");
        let level = state.get("dungeon.level");
        let hero_dx = 624;
        let hero_dy = 240;

        ext.scene.reset();
        ui.layout(276, 80, 728, 244, 20, 500, 1240, 188);
        text.clear();
        text.choices_named();
        ext.rpg.clear();

        if map == "town" {
            state.set("game.location", "town");
            state.set("map.projection", "tile2d");
            if x < 10 {
                state.set("view.sx", 0);
            } else if x > 53 {
                state.set("view.sx", 1408);
            } else {
                state.set("view.sx", x * 32 - 320);
            }
            if y < 7 {
                state.set("view.sy", 0);
            } else if y > 56 {
                state.set("view.sy", 1568);
            } else {
                state.set("view.sy", y * 32 - 224);
            }
            let town_sx = state.get("view.sx");
            let town_sy = state.get("view.sy");
            ui.background(100);
            ext.image.draw_ext(town_map, town_sx, town_sy, 640, 448, 320, 32, 640, 448, 0, 1);
            let gate_dx = 320 + 32 * 32 - town_sx;
            let gate_dy = 32 + 32 * 32 - town_sy;
            ext.image.draw_ext(landmark_icons, 64, 0, 64, 64, gate_dx, gate_dy, 32, 32, 0, 1);
            ext.image.draw_ext(actor_icons, 0, 0, 64, 64, hero_dx, hero_dy, 32, 32, 0, 1);

            ext.rpg.map_controls("tile2d", "north", "south", "east", "west");
            if x == 32 && y == 32 {
                ext.rpg.hud("町の東門", "森への門です。方向キーで移動、1..9 でアクション。");
                ext.rpg.actions(
                    "forest", "森へ出る",
                    "status", "ステータス",
                    "inventory", "所持品",
                    "end_demo", "デモ終了"
                );
            } else if x == 30 && y == 32 {
                ext.rpg.hud("町の広場", "中央広場です。東へ二歩進むと森へ続く門があります。");
                ext.rpg.actions(
                    "status", "ステータス",
                    "inventory", "所持品",
                    "end_demo", "デモ終了"
                );
            } else {
                ext.rpg.hud("町区画", "石畳の路地が続いています。迷ったら広場か東門へ戻れます。");
                ext.rpg.actions(
                    "return_town", "広場へ戻る",
                    "gate", "東門へ戻る",
                    "end_demo", "デモ終了"
                );
            }
            recv();
            let action = state.get("ui.last_choice");
            ext.rpg.clear();
            state.set("game.last_action", action);
            state.set("map.last_blocked", false);

            if action == "north" {
                if y > 0 {
                    state.set("map.y", y - 1);
                } else {
                    state.set("map.last_blocked", true);
                }
            } else if action == "south" {
                if y < 63 {
                    state.set("map.y", y + 1);
                } else {
                    state.set("map.last_blocked", true);
                }
            } else if action == "east" {
                if x < 63 {
                    state.set("map.x", x + 1);
                } else {
                    state.set("map.last_blocked", true);
                }
            } else if action == "west" {
                if x > 0 {
                    state.set("map.x", x - 1);
                } else {
                    state.set("map.last_blocked", true);
                }
            }

            if action == "north" || action == "south" || action == "east" || action == "west" {
                let moved_x = state.get("map.x");
                let moved_y = state.get("map.y");
                state.set("map.path_ok", false);
                if moved_y == 32 && moved_x >= 30 && moved_x <= 32 {
                    state.set("map.path_ok", true);
                }
                if state.get("map.path_ok") == false {
                    state.set("map.x", x);
                    state.set("map.y", y);
                    state.set("map.last_blocked", true);
                }
            } else if action == "forest" {
                state.set("map.current", "forest");
                state.set("map.x", 2);
                state.set("map.y", 32);
                state.set("map.z", 0);
                state.set("map.transition", "town_to_forest");
                state.set("flag.map_switched", true);
            } else if action == "return_town" {
                state.set("map.x", 30);
                state.set("map.y", 32);
            } else if action == "gate" {
                state.set("map.x", 32);
                state.set("map.y", 32);
            } else if action == "status" {
                state.set("game.mode", "menu");
                text.show("ステータス", "主人公 HP 30/30  ATK 7  DEF 2\n現在地: 町");
                recv();
            } else if action == "inventory" {
                state.set("game.mode", "menu");
                text.show("所持品", "ポーション x1\nゴールド 12");
                recv();
            } else if action == "end_demo" {
                if state.get("flag.dungeon_descended") {
                    return "rpg-dungeon-depth";
                } else if state.get("flag.stone_read") {
                    return "rpg-stone-read";
                } else if state.get("flag.slime_defeated") {
                    return "rpg-victory";
                } else if state.get("flag.map_switched") {
                    return "rpg-map-switch";
                } else {
                    return "rpg-map-idle";
                }
            }
        } else if map == "forest" {
            state.set("game.location", "forest");
            state.set("map.projection", "tile2d");
            if x < 10 {
                state.set("view.sx", 0);
            } else if x > 53 {
                state.set("view.sx", 1408);
            } else {
                state.set("view.sx", x * 32 - 320);
            }
            if y < 7 {
                state.set("view.sy", 0);
            } else if y > 56 {
                state.set("view.sy", 1568);
            } else {
                state.set("view.sy", y * 32 - 224);
            }
            let forest_sx = state.get("view.sx");
            let forest_sy = state.get("view.sy");
            ui.background(101);
            ext.image.draw_ext(forest_map, forest_sx, forest_sy, 640, 448, 320, 32, 640, 448, 0, 1);
            let town_dx = 320 + 1 * 32 - forest_sx;
            let town_dy = 32 + 32 * 32 - forest_sy;
            let stone_dx = 320 + 2 * 32 - forest_sx;
            let stone_dy = 32 + 30 * 32 - forest_sy;
            let slime_dx = 320 + 4 * 32 - forest_sx;
            let slime_dy = 32 + 32 * 32 - forest_sy;
            let stairs_dx = 320 + 2 * 32 - forest_sx;
            let stairs_dy = 32 + 33 * 32 - forest_sy;
            ext.image.draw_ext(landmark_icons, 64, 0, 64, 64, town_dx, town_dy, 32, 32, 0, 1);
            ext.image.draw_ext(landmark_icons, 128, 0, 64, 64, stone_dx, stone_dy, 32, 32, 0, 1);
            ext.image.draw_ext(landmark_icons, 192, 0, 64, 64, slime_dx, slime_dy, 32, 32, 0, 1);
            ext.image.draw_ext(landmark_icons, 256, 0, 64, 64, stairs_dx, stairs_dy, 32, 32, 0, 1);
            ext.image.draw_ext(actor_icons, 0, 0, 64, 64, hero_dx, hero_dy, 32, 32, 0, 1);

            ext.rpg.map_controls("tile2d", "north", "south", "east", "west");
            if x == 1 && y == 32 {
                ext.rpg.hud("森の出口", "町へ戻る境界です。");
                ext.rpg.actions("town", "町へ戻る", "end_demo", "デモ終了");
            } else if x == 2 && y == 30 {
                ext.rpg.hud("森の石碑", "苔むした石碑が木漏れ日の中に立っています。");
                ext.rpg.actions(
                    "check", "石碑を調べる",
                    "return_forest", "森入口へ戻る",
                    "town", "町へ戻る",
                    "end_demo", "デモ終了"
                );
            } else if x == 2 && y == 33 {
                ext.rpg.hud("森の地下入口", "木の根の間に、地下遺跡へ降りる石段があります。");
                ext.rpg.actions(
                    "return_forest", "森入口へ戻る",
                    "town", "町へ戻る",
                    "end_demo", "デモ終了"
                );
            } else if x == 4 && y == 32 {
                state.set("game.mode", "battle");
                ext.rpg.clear();
                ui.background(103);
                ext.image.draw_ext(battle_bg, 0, 0, 1280, 720, 0, 0, 1280, 720, 0, 1);
                text.show("スライム", "森の小道でスライムが跳ねている。");
                recv();
                text.show("スライム", "どうする？");
                text.choices_named("attack", "攻撃", "guard", "防御", "potion", "ポーション", "run", "逃げる");
                recv();
                let battle1 = state.get("ui.last_choice");
                text.choices_named();
                if battle1 == "run" {
                    state.set("map.x", 2);
                    state.set("map.y", 32);
                    text.show("語り", "主人公は森の入口へ戻った。");
                    recv();
                } else if battle1 == "potion" {
                    state.set("inventory.potion", 0);
                    state.set("actor.hero.hp", 30);
                    text.show("語り", "ポーションで体勢を整えた。");
                    recv();
                } else {
                    ext.audio.playback(battle_hit, false);
                    state.set("actor.slime.hp", 12);
                    state.set("actor.hero.hp", 27);
                    text.show("語り", "攻撃が当たった。スライム HP 12、主人公 HP 27。");
                    recv();
                }

                if battle1 != "run" {
                    text.show("スライム", "まだ向かってくる。");
                    text.choices_named("attack", "攻撃", "guard", "防御", "potion", "ポーション", "run", "逃げる");
                    recv();
                    let battle2 = state.get("ui.last_choice");
                    text.choices_named();
                    if battle2 == "run" {
                        state.set("map.x", 2);
                        state.set("map.y", 32);
                        text.show("語り", "主人公は無理をせず退いた。");
                        recv();
                    } else if battle2 == "guard" {
                        state.set("actor.hero.hp", 26);
                        text.show("語り", "盾で体当たりを受け流した。");
                        recv();
                    } else {
                        ext.audio.playback(battle_hit, false);
                        state.set("actor.slime.hp", 6);
                        state.set("actor.hero.hp", 24);
                        text.show("語り", "追撃が入った。スライム HP 6、主人公 HP 24。");
                        recv();
                    }

                    if battle2 != "run" {
                        text.show("スライム", "あと少しだ。");
                        text.choices_named("attack", "攻撃", "guard", "防御", "potion", "ポーション", "run", "逃げる");
                        recv();
                        let battle3 = state.get("ui.last_choice");
                        text.choices_named();
                        if battle3 == "run" {
                            state.set("map.x", 2);
                            state.set("map.y", 32);
                            text.show("語り", "主人公は安全を優先した。");
                            recv();
                        } else {
                            ext.audio.playback(battle_hit, false);
                            state.set("actor.slime.hp", 0);
                            state.set("flag.slime_defeated", true);
                            state.set("resource.gold", 20);
                            state.set("map.x", 2);
                            state.set("map.y", 32);
                            text.show("語り", "スライムは森の奥へ逃げた。ゴールドは 20 になった。");
                            recv();
                        }
                    }
                }
            } else {
                ext.rpg.hud("森の入口", "北に石碑、東にスライム、南に地下入口があります。");
                ext.rpg.actions(
                    "return_forest", "森入口へ戻る",
                    "town", "町へ戻る",
                    "end_demo", "デモ終了"
                );
            }

            if state.get("game.mode") == "map" {
                recv();
                let action = state.get("ui.last_choice");
                ext.rpg.clear();
                state.set("game.last_action", action);
                state.set("map.last_blocked", false);
                if action == "north" {
                    if y > 0 {
                        state.set("map.y", y - 1);
                    } else {
                        state.set("map.last_blocked", true);
                    }
                } else if action == "south" {
                    if x == 2 && y == 33 {
                        state.set("map.current", "dungeon");
                        state.set("map.projection", "grid3d");
                        state.set("map.x", 30);
                        state.set("map.y", 1);
                        state.set("map.z", 30);
                        state.set("map.facing", "north");
                        state.set("dungeon.level", 1);
                        state.set("map.transition", "forest_to_dungeon");
                        state.set("flag.map_switched", true);
                    } else if y < 63 {
                        state.set("map.y", y + 1);
                    } else {
                        state.set("map.last_blocked", true);
                    }
                } else if action == "east" {
                    if x < 63 {
                        state.set("map.x", x + 1);
                    } else {
                        state.set("map.last_blocked", true);
                    }
                } else if action == "west" {
                    if x > 0 {
                        state.set("map.x", x - 1);
                    } else {
                        state.set("map.last_blocked", true);
                    }
                }

                if action == "north" || action == "south" || action == "east" || action == "west" {
                    if state.get("map.current") == "forest" {
                        let moved_x = state.get("map.x");
                        let moved_y = state.get("map.y");
                        state.set("map.path_ok", false);
                        if moved_y == 32 && moved_x >= 1 && moved_x <= 4 {
                            state.set("map.path_ok", true);
                        } else if moved_x == 2 && moved_y >= 30 && moved_y <= 33 {
                            state.set("map.path_ok", true);
                        }
                        if state.get("map.path_ok") == false {
                            state.set("map.x", x);
                            state.set("map.y", y);
                            state.set("map.last_blocked", true);
                        }
                    }
                } else if action == "town" {
                    state.set("map.current", "town");
                    state.set("map.x", 32);
                    state.set("map.y", 32);
                    state.set("map.transition", "forest_to_town");
                    state.set("flag.map_switched", true);
                } else if action == "return_forest" {
                    state.set("map.x", 2);
                    state.set("map.y", 32);
                } else if action == "check" {
                    state.set("game.mode", "event");
                    ext.rpg.clear();
                    ext.audio.playback(stone_chime, false);
                    ui.background(102);
                    text.show(
                        "石碑",
                        "石碑には、森の仕事を自動化した古いギルドの記録が刻まれている。\n「薬草畑は一日一束。水路を直せば、冒険者は戦いに専念できる」"
                    );
                    text.choices_named("read", "最後まで読む", "leave", "読むのをやめる");
                    recv();
                    let event_action = state.get("ui.last_choice");
                    text.choices_named();
                    if event_action == "read" {
                        state.set("resource.gold", 15);
                        state.set("job.herb_garden.enabled", true);
                        state.set("job.herb_garden.progress", 1);
                        state.set("flag.stone_read", true);
                        text.show("語り", "読み終えると古い金貨が三枚こぼれた。薬草畑 job も起動可能になった。");
                        recv();
                    } else {
                        text.show("語り", "主人公は石碑から離れた。");
                        recv();
                    }
                    state.set("game.mode", "map");
                    state.set("map.current", "forest");
                    state.set("map.x", 2);
                    state.set("map.y", 30);
                } else if action == "end_demo" {
                    if state.get("flag.dungeon_descended") {
                        return "rpg-dungeon-depth";
                    } else if state.get("flag.stone_read") {
                        return "rpg-stone-read";
                    } else if state.get("flag.slime_defeated") {
                        return "rpg-victory";
                    } else if state.get("flag.map_switched") {
                        return "rpg-map-switch";
                    } else {
                        return "rpg-map-idle";
                    }
                }
            }
        } else if map == "dungeon" {
            state.set("game.location", "dungeon");
            state.set("map.projection", "grid3d");
            ui.background(106);
            ext.image.draw_ext(dungeon_view, 0, 0, 1280, 720, 0, 0, 1280, 720, 0, 1);
            if x < 10 {
                state.set("view.sx", 0);
            } else if x > 53 {
                state.set("view.sx", 1408);
            } else {
                state.set("view.sx", x * 32 - 320);
            }
            if z < 7 {
                state.set("view.sy", 0);
            } else if z > 56 {
                state.set("view.sy", 1568);
            } else {
                state.set("view.sy", z * 32 - 224);
            }
            let dungeon_sx = state.get("view.sx");
            let dungeon_sy = state.get("view.sy");
            ext.image.draw_ext(dungeon_map, dungeon_sx, dungeon_sy, 640, 448, 24, 40, 256, 180, 0, 1);
            ext.image.draw_ext(actor_icons, 0, 0, 64, 64, 136, 108, 28, 28, 0, 1);

            ext.rpg.map_controls("grid3d", "forward", "back", "turn_left", "turn_right");
            if level == 2 {
                ext.rpg.hud("地下遺跡 B2", "階段を降りると、空気が冷たく重くなりました。");
                ext.rpg.actions("check", "周囲を調べる", "exit_dungeon", "森へ戻る", "end_demo", "デモ終了");
            } else if x == 31 && z == 31 {
                ext.rpg.hud("地下遺跡 階段", "右奥の通路で下り階段を見つけました。");
                ext.rpg.actions("check", "階段を調べる", "exit_dungeon", "森へ戻る", "end_demo", "デモ終了");
            } else {
                ext.rpg.hud("地下遺跡 通路", "正面の石壁に古い紋様が刻まれています。");
                ext.rpg.actions("check", "周囲を調べる", "exit_dungeon", "森へ戻る", "end_demo", "デモ終了");
            }
            recv();
            let action = state.get("ui.last_choice");
            ext.rpg.clear();
            state.set("game.last_action", action);
            state.set("map.last_blocked", false);

            if action == "forward" {
                if facing == "north" {
                    if z < 63 { state.set("map.z", z + 1); } else { state.set("map.last_blocked", true); }
                } else if facing == "south" {
                    if z > 0 { state.set("map.z", z - 1); } else { state.set("map.last_blocked", true); }
                } else if facing == "east" {
                    if x < 63 { state.set("map.x", x + 1); } else { state.set("map.last_blocked", true); }
                } else if facing == "west" {
                    if x > 0 { state.set("map.x", x - 1); } else { state.set("map.last_blocked", true); }
                }
            } else if action == "back" {
                if facing == "north" {
                    if z > 0 { state.set("map.z", z - 1); } else { state.set("map.last_blocked", true); }
                } else if facing == "south" {
                    if z < 63 { state.set("map.z", z + 1); } else { state.set("map.last_blocked", true); }
                } else if facing == "east" {
                    if x > 0 { state.set("map.x", x - 1); } else { state.set("map.last_blocked", true); }
                } else if facing == "west" {
                    if x < 63 { state.set("map.x", x + 1); } else { state.set("map.last_blocked", true); }
                }
            }

            if action == "forward" || action == "back" {
                let moved_x = state.get("map.x");
                let moved_z = state.get("map.z");
                state.set("map.path_ok", false);
                if level == 1 {
                    if (moved_x == 30 && moved_z == 30) || (moved_x == 30 && moved_z == 31) || (moved_x == 31 && moved_z == 31) {
                        state.set("map.path_ok", true);
                    }
                } else if level == 2 {
                    if moved_x >= 29 && moved_x <= 31 && moved_z >= 33 && moved_z <= 35 {
                        state.set("map.path_ok", true);
                    }
                }
                if state.get("map.path_ok") == false {
                    state.set("map.x", x);
                    state.set("map.z", z);
                    state.set("map.last_blocked", true);
                }
            } else if action == "turn_left" {
                if facing == "north" {
                    state.set("map.facing", "west");
                } else if facing == "west" {
                    state.set("map.facing", "south");
                } else if facing == "south" {
                    state.set("map.facing", "east");
                } else {
                    state.set("map.facing", "north");
                }
            } else if action == "turn_right" {
                if facing == "north" {
                    state.set("map.facing", "east");
                } else if facing == "east" {
                    state.set("map.facing", "south");
                } else if facing == "south" {
                    state.set("map.facing", "west");
                } else {
                    state.set("map.facing", "north");
                }
            } else if action == "check" {
                if x == 31 && z == 31 {
                    state.set("flag.dungeon_descended", true);
                    state.set("dungeon.level", 2);
                    state.set("map.x", 30);
                    state.set("map.z", 34);
                    text.show("地下遺跡", "階段を降り、さらに深い階層に入りました。");
                    recv();
                } else {
                    text.show("地下遺跡", "壁の紋様を確認しました。階段は入口から前へ進み、右を向いて一歩進んだ先です。");
                    recv();
                }
            } else if action == "exit_dungeon" {
                state.set("map.current", "forest");
                state.set("map.projection", "tile2d");
                state.set("map.x", 2);
                state.set("map.y", 32);
                state.set("map.z", 0);
                state.set("map.facing", "north");
                state.set("dungeon.level", 0);
                state.set("map.transition", "dungeon_to_forest");
                state.set("flag.map_switched", true);
            } else if action == "end_demo" {
                if state.get("flag.dungeon_descended") {
                    return "rpg-dungeon-depth";
                } else if state.get("flag.map_switched") {
                    return "rpg-map-switch";
                } else {
                    return "rpg-map-idle";
                }
            }
        }
    }
}
